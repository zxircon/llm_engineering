#Kaynak: SQL veritabanı (canlı)
#Vektör DB: Chroma
#Embedding: OpenAI
#LLM: GPT-4o-mini
#sadece degisien kısımlar otomatik update ediliyor

import os, json, hashlib, pandas as pd, psycopg2
from datetime import datetime, timezone
from langchain.embeddings import OpenAIEmbeddings
from langchain.vectorstores import Chroma
from langchain.schema import Document

PERSIST_DIR = "erp_chroma"
STATE_FILE = "last_sync.json"

def load_state():
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {"last_sync": "1970-01-01T00:00:00Z"}

def save_state(dt_iso):
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        json.dump({"last_sync": dt_iso}, f)

def fetch_since(ts_iso):
    conn = psycopg2.connect(
        dbname="erp_db", user="username", password="password",
        host="localhost", port="5432"
    )
    # Not: product_id unique, updated_at timestamptz varsayıldı
    q_changed = """
      SELECT product_id, product_name, category, stock, price, updated_at
      FROM products
      WHERE updated_at > %s
    """
    changed = pd.read_sql(q_changed, conn, params=[ts_iso])

    # ERP’de mevcut tüm id’ler (silinenleri anlamak için)
    q_all_ids = "SELECT product_id FROM products"
    all_ids = pd.read_sql(q_all_ids, conn)["product_id"].astype(str).tolist()
    conn.close()
    return changed, set(all_ids)

def df_to_documents(df):
    docs, ids, metadatas = [], [], []
    for _, r in df.iterrows():
        pid = str(r["product_id"])
        text = f"Product: {r['product_name']}, Category: {r['category']}, Stock: {r['stock']}, Price: {r['price']}"
        # İçerik değişimini izlemek için checksum (opsiyonel ama yararlı)
        checksum = hashlib.md5(text.encode("utf-8")).hexdigest()
        docs.append(text)
        ids.append(pid)
        metadatas.append({
            "product_id": pid,
            "category": r["category"],
            "updated_at": str(r["updated_at"]),
            "checksum": checksum
        })
    return ids, docs, metadatas

def get_chroma():
    return Chroma(embedding_function=OpenAIEmbeddings(), persist_directory=PERSIST_DIR)

def chroma_ids(vdb):
    # Tüm id’leri almak için küçük parti tarama
    all_ids = []
    cursor = None
    while True:
        batch = vdb._collection.get(ids=None, limit=1000, offset=len(all_ids))
        if not batch["ids"]:
            break
        all_ids.extend(batch["ids"])
    return set(all_ids)

def upsert(vdb, ids, texts, metas):
    # Güvenli yol: mevcutsa sil, sonra ekle
    if ids:
        vdb.delete(ids=ids)
        vdb.add(ids=ids, documents=texts, metadatas=metas)
        vdb.persist()

def incremental_refresh():
    state = load_state()
    last_sync = state["last_sync"]

    print(f"Incremental start since {last_sync}")
    changed_df, erp_all_ids = fetch_since(last_sync)

    vdb = get_chroma()
    vdb_ids = chroma_ids(vdb)

    # 1) Yeni/Değişen kayıtlar: upsert
    if not changed_df.empty:
        ids, texts, metas = df_to_documents(changed_df)
        upsert(vdb, ids, texts, metas)
        print(f"- Upserted: {len(ids)}")

    # 2) Silinen kayıtlar: Chroma’da olup ERP’de olmayanları sil
    to_delete = list(vdb_ids - erp_all_ids)
    if to_delete:
        vdb.delete(ids=to_delete)
        vdb.persist()
        print(f"- Deleted (missing in ERP): {len(to_delete)}")

    # 3) Son senkron saatini şimdi yap
    now_iso = datetime.now(timezone.utc).isoformat()
    save_state(now_iso)
    print(f"Incremental finished at {now_iso}")

if __name__ == "__main__":
    incremental_refresh()
