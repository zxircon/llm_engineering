#Kaynak: SQL veritabanı (canlı)
#Vektör DB: Chroma
#Embedding: OpenAI
#LLM: GPT-4o-mini


import os
import pandas as pd
import psycopg2
from datetime import datetime
from openai import OpenAI
from langchain.embeddings import OpenAIEmbeddings
from langchain.vectorstores import Chroma
from langchain.schema import Document
from langchain.chains import ConversationalRetrievalChain
from langchain.chat_models import ChatOpenAI

# --- 1. Ortam değişkenleri ---
os.environ["OPENAI_API_KEY"] = "YOUR_OPENAI_KEY"

# --- 2. ERP DB bağlantısı ---
def fetch_erp_data():
    conn = psycopg2.connect(
        dbname="erp_db",
        user="username",
        password="password",
        host="localhost",
        port="5432"
    )
    query = """
    SELECT product_id, product_name, category, stock, price
    FROM products
    """
    df = pd.read_sql(query, conn)
    conn.close()
    return df

# --- 3. DataFrame → LangChain Document formatı ---
def df_to_documents(df):
    docs = []
    for _, row in df.iterrows():
        text = f"Product: {row['product_name']}, Category: {row['category']}, Stock: {row['stock']}, Price: {row['price']}"
        meta = {"product_id": row["product_id"]}
        docs.append(Document(page_content=text, metadata=meta))
    return docs

# --- 4. RAG Pipeline Kurulumu ---
def build_vector_db(documents, persist_dir="erp_chroma"):
    embeddings = OpenAIEmbeddings()
    vectordb = Chroma.from_documents(documents, embedding=embeddings, persist_directory=persist_dir)
    vectordb.persist()
    return vectordb

def create_rag_chain(vectordb):
    retriever = vectordb.as_retriever(search_kwargs={"k": 5})
    llm = ChatOpenAI(model="gpt-4o-mini", temperature=0)
    return ConversationalRetrievalChain.from_llm(llm, retriever)

# --- 5. Çalıştırma ---
if __name__ == "__main__":
    print("ERP verisi çekiliyor...")
    df = fetch_erp_data()
    print(f"{len(df)} satır veri alındı.")

    print("Embedding + Chroma index oluşturuluyor...")
    docs = df_to_documents(df)
    vectordb = build_vector_db(docs)

    print("RAG zinciri başlatılıyor...")
    rag_chain = create_rag_chain(vectordb)

    # Örnek sorgu
    chat_history = []
    question = "Stok seviyesi 50'den fazla olan ürünler hangileri?"
    result = rag_chain({"question": question, "chat_history": chat_history})
    print("\nSoru:", question)
    print("Yanıt:", result["answer"])
