#Kaynak: SQL veritabanı (canlı)
#Vektör DB: Chroma
#Embedding: OpenAI
#LLM: GPT-4o-mini
#her gün saat 03:00 (Europe/Istanbul)’da ERP’den veriyi çekip Chroma indeksini baştan kurar. (Basit ve güvenli yol.)

# scheduler_rag_refresh.py
import os
import shutil
import pandas as pd
import psycopg2
from datetime import datetime
from langchain.embeddings import OpenAIEmbeddings
from langchain.vectorstores import Chroma
from langchain.schema import Document
from langchain.chat_models import ChatOpenAI
from langchain.chains import ConversationalRetrievalChain

from apscheduler.schedulers.background import BackgroundScheduler
from apscheduler.triggers.cron import CronTrigger
import pytz
import tempfile

# --- Ortam ---
os.environ["OPENAI_API_KEY"] = os.getenv("OPENAI_API_KEY")

# --- ERP veri çekme ---
def fetch_erp_data():
    conn = psycopg2.connect(
        dbname="erp_db",
        user="username",
        password="password",
        host="localhost",
        port="5432"
    )
    df = pd.read_sql("""
        SELECT product_id, product_name, category, stock, price
        FROM products
    """, conn)
    conn.close()
    return df

def df_to_documents(df):
    docs = []
    for _, row in df.iterrows():
        text = f"Product: {row['product_name']}, Category: {row['category']}, Stock: {row['stock']}, Price: {row['price']}"
        meta = {"product_id": row["product_id"], "category": row["category"]}
        docs.append(Document(page_content=text, metadata=meta))
    return docs

PERSIST_DIR = "erp_chroma"

def rebuild_vector_db():
    print(f"[{datetime.now()}] Güncelleme başladı…")
    df = fetch_erp_data()
    print(f"- {len(df)} satır geldi")

    docs = df_to_documents(df)

    # Geçici klasörde güvenli rebuild → atomik değişim
    with tempfile.TemporaryDirectory() as tmpdir:
        embeddings = OpenAIEmbeddings()
        vectordb = Chroma.from_documents(docs, embedding=embeddings, persist_directory=tmpdir)
        vectordb.persist()

        # Eski klasörü yedekle/sil ve yenisiyle değiştir
        if os.path.exists(PERSIST_DIR):
            shutil.rmtree(PERSIST_DIR)
        shutil.copytree(tmpdir, PERSIST_DIR)

    print(f"[{datetime.now()}] Güncelleme tamamlandı. Persist dir: {PERSIST_DIR}")

def build_chain():
    # (İsteğe bağlı): Sorgulama için zincir
    vectordb = Chroma(embedding_function=OpenAIEmbeddings(), persist_directory=PERSIST_DIR)
    retriever = vectordb.as_retriever(search_kwargs={"k": 5})
    llm = ChatOpenAI(model="gpt-4o-mini", temperature=0)
    return ConversationalRetrievalChain.from_llm(llm, retriever)

def main():
    # İlk kurulum/manuel tetikleme
    rebuild_vector_db()

    # Her gün 03:00 Europe/Istanbul
    tz = pytz.timezone("Europe/Istanbul")
    scheduler = BackgroundScheduler(timezone=tz)
    scheduler.add_job(rebuild_vector_db, CronTrigger(hour=3, minute=0))
    scheduler.start()

    print("Scheduler çalışıyor. Ctrl+C ile çıkabilirsiniz.")
    try:
        # Basit bekleme döngüsü
        while True:
            pass
    except KeyboardInterrupt:
        scheduler.shutdown()

if __name__ == "__main__":
    main()
